# Orccut — single-user MCP video editor. Copy to .env and adjust.
# Every variable is optional except MCP_AUTH_ENABLED (see below).

# REQUIRED. This build is single-user: whoever can reach the port is the
# operator. The setting defaults to true (the cloud edition's safe default),
# and this build refuses to start with it on — set it to false explicitly so
# an open server is always a decision, never an accident. Bind to 127.0.0.1
# (default via docker/compose is up to you) or put a reverse proxy with auth
# in front if the port is reachable by others.
MCP_AUTH_ENABLED=false

# Where the SQLite database lives (default: ./data/editor.db).
# DATABASE_URL=sqlite:///./data/editor.db
# PostgreSQL instead (install the .[postgres] extra):
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/orccut

# Media workspace: originals, exports, previews, caches (default: ./media).
# MEDIA_DIR=./media
# Model downloads for ASR/TTS extras (default: ./models).
# MODELS_DIR=./models

# Bind address/port for the MCP server (default 0.0.0.0:8100; the MCP
# endpoint is http://<host>:8100/mcp).
# MCP_HOST=127.0.0.1
# MCP_PORT=8100
# Transport: streamable-http (default) or stdio.
# MCP_TRANSPORT=streamable-http

# Render engine: mlt (default, needs `melt` installed) or ffmpeg.
# RENDER_ENGINE=mlt
# Path to the melt binary if not on PATH.
# MELT_BINARY=melt

# Font used to rasterize text overlays and captions.
# FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Artifact retention (hours). Exports and clip caches are swept by a
# background daemon; keep your own copies of anything you care about.
# EXPORT_TTL_HOURS=24
# CLIP_CACHE_TTL_HOURS=48
# Disable sweeping entirely on a personal machine:
# RETENTION_ENABLED=false

# Auto-captions model (install the .[asr] extra): tiny/base/small/medium/large-v3
# ASR_MODEL_SIZE=small

# Outbound URL-import guard: comma-separated CIDR allowlist. The default
# blocks private/loopback ranges (SSRF protection); widen it only if you
# import from hosts inside your own network.
# EGRESS_ALLOWED_NETWORKS=
